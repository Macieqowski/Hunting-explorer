{
  "name": "hunting-explorer",
  "version": "1.0.0",
  "description": "Interactive map of Polish hunting districts (obwody łowieckie) and the hunting clubs (koła łowieckie) that lease them.",
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.landing.config.ts",
    "preview": "vite preview --config vite.landing.config.ts",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only database --project demo-hunting \"vitest run --config vitest.rules.config.ts\"",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Macieqowski/Hunting-explorer.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Macieqowski/Hunting-explorer/issues"
  },
  "homepage": "https://github.com/Macieqowski/Hunting-explorer#readme",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "firebase": "^13.2.0",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/leaflet": "^1.9.22",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}
