VITE_FIREBASE_AUTH_DOMAIN=myslistwo-app.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://myslistwo-app-default-rtdb.europe-west1.firebasedatabase.app/
VITE_FIREBASE_PROJECT_ID=myslistwo-app
VITE_FIREBASE_APP_ID=1:965448077697:web:563d55d8374c685c09d880
VITE_ORAL_API_URL=https://polowanie-oral.polowanie.workers.dev
