<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the website (invitations, leader pairing codes) open the app.
                 Verified by landing/public/.well-known/assetlinks.json on www.polowanie.org.
                 Only www: polowanie.org answers with a redirect, which Android's check does not
                 follow, and on Android 11 and older one failed host fails the whole app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.polowanie.org" />
            </intent-filter>

        </activity>

        <!-- Location sharing with the screen off (BackgroundLocationPlugin). -->
        <service
            android:name=".LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Saving offline maps with the screen off (TileDownloadPlugin). -->
        <service
            android:name=".TileDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sharing your position in a group hunt, the map's "my location", weather for here. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Keeps sharing your position with the screen off: a foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Saving offline maps goes on with the screen off: a foreground service with a progress
         notification, which keeps the phone (and its Wi-Fi) awake until the save ends. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- It waits for signal instead of failing every tile when there is none. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- That notification, and hunt alerts (messages, drives) while the app is in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Buzzing on hunt alerts, messages and leaving the beater route (AlertsPlugin). -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
